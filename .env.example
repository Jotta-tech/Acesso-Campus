# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NÃO deve ser enviado ao Git (já está no .gitignore).

# Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True apenas em desenvolvimento local. Nunca use True em um servidor público.
DEBUG=True

# Hosts permitidos, separados por vírgula.
ALLOWED_HOSTS=127.0.0.1,localhost

# Limite de ocorrências criadas por IP anônimo (formato: numero/periodo,
# onde periodo é second, minute, hour ou day).
THROTTLE_CRIACAO_ANONIMA=60/hour
